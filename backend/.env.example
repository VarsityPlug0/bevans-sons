DATABASE_URL="postgresql://user:password@localhost:5432/sneaker_store"

# JWT Secrets — use different secrets for customer and admin
JWT_SECRET="change-me-customer-secret-min-32-chars"
JWT_ADMIN_SECRET="change-me-admin-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_ADMIN_EXPIRES_IN="8h"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Yoco (payment gateway — South Africa)
YOCO_SECRET_KEY=""
YOCO_PUBLIC_KEY=""

# App
STORE_NAME="Sneaker Store"
