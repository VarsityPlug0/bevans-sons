# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sneaker_store"

# ── JWT Secrets (generate with: openssl rand -hex 32) ─────────────────────────
JWT_SECRET="change-me-min-32-chars"
JWT_ADMIN_SECRET="change-me-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_ADMIN_EXPIRES_IN="8h"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS (set to your actual deployed URLs) ────────────────────────────────────
FRONTEND_URL="https://bevanssons.store"
ADMIN_URL="https://admin.bevanssons.store"
BACKEND_URL="https://api.bevanssons.store"

# ── Cloudinary (cloud.cloudinary.com → API Keys) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── PayFast (payfast.co.za → Account → Settings → Integration) ────────────────
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="false"

# ── OpenRouter (admin AI chatbot — openrouter.ai) ─────────────────────────────
OPENROUTER_API_KEY=""

# ── Store defaults ─────────────────────────────────────────────────────────────
STORE_NAME="Bevans Sons"
STORE_EMAIL="MkhabeleEnterprise@gmail.com"
STORE_PHONE="0724816274"
STORE_REG="2023/116995/07"
