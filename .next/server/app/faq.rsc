13:["$","div","Do I need council or municipality approval for solar?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Do I need council or municipality approval for solar?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"For grid-tied systems above 1kW, South African municipalities require registration and a Certificate of Compliance (COC). We handle this process for you as part of the installation."}]]}]
14:["$","section","Inverters & Batteries",{"id":"inverters-batteries","children":[["$","div",null,{"className":"flex items-center gap-4 mb-5","children":[["$","h2",null,{"className":"text-lg font-bold text-white whitespace-nowrap","children":"Inverters & Batteries"}],["$","div",null,{"className":"flex-1 h-px bg-[#1F1F1F]"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","div","Which inverter should I choose?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Which inverter should I choose?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"For most homes, a 5kW or 8kW hybrid inverter is ideal. A 5kW handles essential loads (lights, fridge, TV, router, computer). An 8kW handles full household loads including a geyser and washing machine. Three-phase inverters (20kW+) are for large homes and businesses."}]]}],["$","div","What is the difference between a hybrid inverter and a normal inverter?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What is the difference between a hybrid inverter and a normal inverter?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"A hybrid inverter can work with solar panels, battery storage, AND the grid simultaneously. A normal (off-grid) inverter only works with battery and solar. Hybrid inverters are more flexible — you stay connected to the grid when needed and use solar/battery when available."}]]}],["$","div","Which battery should I choose?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Which battery should I choose?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"We recommend lithium batteries over lead-acid for solar storage. Our 100Ah lithium battery (5.12kWh) is suitable for 6–10 hours of essential appliance backup. Our 200Ah battery (10.24kWh) provides 12–18 hours and is best for full household coverage."}]]}],["$","div","How long do lithium batteries last?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"How long do lithium batteries last?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Our lithium batteries are rated for 6,000+ charge cycles. At one full cycle per day, that is over 16 years of daily use. Lithium batteries maintain consistent performance throughout their lifespan, unlike lead-acid batteries which degrade significantly after 2–3 years."}]]}],["$","div","Can I run my house entirely off-grid?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Can I run my house entirely off-grid?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Yes, with the right system size. Our Business Home Pro package (20kW inverter + 400Ah battery storage) can power large homes independently. For full off-grid capability, we assess your exact consumption and configure accordingly."}]]}]]}]]}]
15:["$","section","Pricing & Quotes",{"id":"pricing-quotes","children":[["$","div",null,{"className":"flex items-center gap-4 mb-5","children":[["$","h2",null,{"className":"text-lg font-bold text-white whitespace-nowrap","children":"Pricing & Quotes"}],["$","div",null,{"className":"flex-1 h-px bg-[#1F1F1F]"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","div","How much does solar cost in South Africa?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"How much does solar cost in South Africa?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Our packages start at R67,500 (Essential Home) and go up to R264,000 (Business Home Pro). Inverter-only backup systems start from R18,000. Commercial systems are custom-priced from R198,400. All prices include standard installation."}]]}],["$","div","What is included in the price?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What is included in the price?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"All our solar packages include: the inverter, solar panels, battery, mounting structure, cabling, and standard installation. You will not receive a bill with hidden extras. Unusual installation requirements (very long cable runs, difficult roof access, etc.) may incur additional charges — we advise upfront."}]]}],["$","div","Do you offer payment plans or financing?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Do you offer payment plans or financing?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"We are working on financing options. Contact us on WhatsApp to discuss payment arrangements. Some customers use personal loans or home equity loans to finance their systems, which still results in net savings once monthly Eskom bills are reduced."}]]}],["$","div","How do I get an official quote?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"How do I get an official quote?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"You can get an estimated quote using our Solar Wizard in under 2 minutes. For an official, binding quote, submit your details via the wizard or contact us directly on WhatsApp. We will assess your requirements and send you a formal quote."}]]}]]}]]}]
16:["$","section","Installation & Delivery",{"id":"installation-delivery","children":[["$","div",null,{"className":"flex items-center gap-4 mb-5","children":[["$","h2",null,{"className":"text-lg font-bold text-white whitespace-nowrap","children":"Installation & Delivery"}],["$","div",null,{"className":"flex-1 h-px bg-[#1F1F1F]"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","div","Do you install?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Do you install?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Yes. We supply and install across all 9 provinces of South Africa. Our installation teams are qualified and we handle all paperwork including the Certificate of Compliance (COC) required for grid-tied systems."}]]}],["$","div","Do you deliver nationwide?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Do you deliver nationwide?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Yes. We deliver to all 9 provinces of South Africa. Electronics and accessories are delivered via courier. Solar systems are typically delivered and installed by our installation teams."}]]}],["$","div","How long does installation take?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"How long does installation take?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"A standard residential installation takes 1–2 days. Large commercial systems may take 3–5 days. We will give you a specific timeline when booking your installation."}]]}],["$","div","What happens during the site assessment?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What happens during the site assessment?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"For solar systems, we assess your roof type and orientation, available space, electrical panel, current consumption, and any obstructions (trees, neighbouring buildings). This allows us to design the optimal system layout and confirm pricing."}]]}],["$","div","How long does delivery take for electronics?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"How long does delivery take for electronics?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Electronics ship within 1–3 business days of payment confirmation. Delivery takes 2–5 business days depending on your province. We use reliable courier partners and provide tracking information."}]]}]]}]]}]
17:["$","section","Warranty & Support",{"id":"warranty-support","children":[["$","div",null,{"className":"flex items-center gap-4 mb-5","children":[["$","h2",null,{"className":"text-lg font-bold text-white whitespace-nowrap","children":"Warranty & Support"}],["$","div",null,{"className":"flex-1 h-px bg-[#1F1F1F]"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","div","What warranty do you provide?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What warranty do you provide?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"All products carry full manufacturer warranties. Solar panels: 25-year output warranty + 10-year product warranty. Inverters: 5–10 years (depending on model). Lithium batteries: 5–10 years (6,000+ cycles). Electronics: standard manufacturer warranty. We handle all warranty claims on your behalf."}]]}],["$","div","What after-sales support do you offer?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What after-sales support do you offer?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"We provide WhatsApp support for questions, troubleshooting, and after-sales assistance. Our team is available to help you get the most from your system. For technical issues, we coordinate with manufacturers and installers on your behalf."}]]}],["$","div","What if something stops working?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What if something stops working?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Contact us immediately on WhatsApp. We will guide you through basic troubleshooting and, if necessary, arrange a technician visit or facilitate a warranty claim with the manufacturer. We do not disappear after the sale."}]]}]]}]]}]
18:["$","section","Electronics",{"id":"electronics","children":[["$","div",null,{"className":"flex items-center gap-4 mb-5","children":[["$","h2",null,{"className":"text-lg font-bold text-white whitespace-nowrap","children":"Electronics"}],["$","div",null,{"className":"flex-1 h-px bg-[#1F1F1F]"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","div","Are your electronics genuine / original products?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Are your electronics genuine / original products?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Yes. We only stock certified, quality-tested products from reputable brands. All electronics come with full manufacturer packaging, documentation, and warranty."}]]}],["$","div","Can I return a product if I'm not satisfied?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Can I return a product if I'm not satisfied?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Electronics can be returned within 7 days if they are in original, unused condition with all packaging. Faulty products are replaced or refunded per the manufacturer warranty. Contact us on WhatsApp to arrange a return."}]]}],["$","div","Do you stock specific brands?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Do you stock specific brands?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"We stock a curated range of premium brands. If you are looking for a specific brand or model not listed, contact us on WhatsApp — we can often source it for you."}]]}]]}]]}]
