b:["$","div",null,{"className":"flex flex-wrap gap-2 justify-center mb-8","children":[["$","a","Solar Systems",{"href":"#solar-systems","className":"text-sm px-4 py-2 rounded-full border border-[#1F1F1F] text-gray-400 hover:border-[#D4AF37]/50 hover:text-[#D4AF37] transition-colors","children":"Solar Systems"}],["$","a","Inverters & Batteries",{"href":"#inverters-batteries","className":"text-sm px-4 py-2 rounded-full border border-[#1F1F1F] text-gray-400 hover:border-[#D4AF37]/50 hover:text-[#D4AF37] transition-colors","children":"Inverters & Batteries"}],["$","a","Pricing & Quotes",{"href":"#pricing-quotes","className":"text-sm px-4 py-2 rounded-full border border-[#1F1F1F] text-gray-400 hover:border-[#D4AF37]/50 hover:text-[#D4AF37] transition-colors","children":"Pricing & Quotes"}],["$","a","Installation & Delivery",{"href":"#installation-delivery","className":"text-sm px-4 py-2 rounded-full border border-[#1F1F1F] text-gray-400 hover:border-[#D4AF37]/50 hover:text-[#D4AF37] transition-colors","children":"Installation & Delivery"}],["$","a","Warranty & Support",{"href":"#warranty-support","className":"text-sm px-4 py-2 rounded-full border border-[#1F1F1F] text-gray-400 hover:border-[#D4AF37]/50 hover:text-[#D4AF37] transition-colors","children":"Warranty & Support"}],["$","a","Electronics",{"href":"#electronics","className":"text-sm px-4 py-2 rounded-full border border-[#1F1F1F] text-gray-400 hover:border-[#D4AF37]/50 hover:text-[#D4AF37] transition-colors","children":"Electronics"}]]}]
c:["$","div",null,{"className":"space-y-8","children":[["$","section","Solar Systems",{"id":"solar-systems","children":[["$","div",null,{"className":"flex items-center gap-4 mb-5","children":[["$","h2",null,{"className":"text-lg font-bold text-white whitespace-nowrap","children":"Solar Systems"}],["$","div",null,{"className":"flex-1 h-px bg-[#1F1F1F]"}]]}],["$","div",null,{"className":"space-y-3","children":[["$","div","What solar system do I need?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What solar system do I need?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"It depends on your home size, monthly electricity bill, and what appliances you want to run. A 2–3 bedroom home with an R1,000–R2,000 monthly bill typically suits our Essential Home package (R67,500). A 3–5 bedroom home typically suits our Premium Home package (R98,000). Use our Solar Wizard for a personalised recommendation in under 2 minutes."}]]}],["$","div","Can solar reduce my electricity bill?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Can solar reduce my electricity bill?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Yes. Depending on your system size and usage, solar can reduce your Eskom bill by 50%–90%. Our Premium Home Solar package typically pays for itself in 3–4 years through bill savings."}]]}],["$","div","What happens during load-shedding with solar?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"What happens during load-shedding with solar?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"With a hybrid inverter and battery, your home automatically switches to stored battery power when the grid goes down. You will not notice load-shedding at all for essential appliances. Depending on your battery capacity and load, a 200Ah battery can power a household for 12–18 hours."}]]}],["$","div","Can I add more batteries later?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Can I add more batteries later?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Yes. Our hybrid inverters are designed to be expandable. You can start with one battery and add more as your needs or budget grows. This is one reason we recommend hybrid systems over off-grid systems."}]]}],["$","div","How long do solar panels last?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"How long do solar panels last?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Our solar panels carry a 25-year output warranty. After 25 years, panels typically still produce at least 80% of their original capacity. The average panel lifespan is 30+ years."}]]}],["$","div","Can solar run my geyser?",{"className":"bg-[#111111] border border-[#1F1F1F] rounded-xl p-4","children":[["$","h3",null,{"className":"text-white font-semibold text-sm mb-2 leading-snug","children":"Can solar run my geyser?"}],["$","p",null,{"className":"text-gray-400 text-sm leading-relaxed","children":"Yes. Our Premium Home and Business Home Pro packages are designed to handle high-draw appliances including geysers (3kW). An Essential Home package can run a geyser but will deplete the battery faster. We recommend using a solar diversion controller or timer with the geyser."}]]}],"$L13"]}]]}],"$L14","$L15","$L16","$L17","$L18"]}]
d:["$","div",null,{"className":"mt-10 bg-[#111111] border border-[#D4AF37]/25 rounded-2xl p-7 text-center","children":[["$","h3",null,{"className":"text-xl font-bold text-white mb-2","children":"Still have a question?"}],["$","p",null,{"className":"text-gray-400 mb-5 max-w-md mx-auto leading-relaxed text-sm","children":"Our team is available on WhatsApp to answer any question about solar, electronics, or your specific requirements."}],["$","div",null,{"className":"flex flex-col sm:flex-row gap-4 justify-center","children":[["$","a",null,{"href":"https://wa.me/27848961782","target":"_blank","rel":"noopener noreferrer","className":"btn-gold px-8 py-3.5 rounded-xl font-bold","children":"Chat on WhatsApp"}],["$","$L19",null,{"href":"/solar/wizard","className":"btn-outline px-8 py-3.5 rounded-xl font-bold","children":"Take the Solar Wizard"}]]}]]}]
